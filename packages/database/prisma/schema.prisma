generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions          Session[]
  accounts          Account[]
  projects          Project[]
  creditWallet      CreditWallet?
  subscriptions     Subscription[]
  payments          Payment[]
  githubAccessToken String?
  teamMemberships   TeamMember[]
  preferredModel    String?       @default("gpt-4o")

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

model Project {
  id            String        @id @default(cuid())
  userId        String
  name          String
  description   String?
  status        ProjectStatus @default(IDLE)
  framework     String        @default("nextjs")
  workspacePath String?
  previewPort   Int?
  previewUrl    String?
  githubRepo    String?       // owner/repo
  githubUrl     String?
  deployUrl     String?
  coolifyAppId  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  files         ProjectFile[]
  aiTasks       AiTask[]
  deployments   Deployment[]
  teamMembers   TeamMember[]
  templateId    String?
  aiModel       String?        @default("gpt-4o")

  @@map("projects")
}

model Deployment {
  id           String           @id @default(cuid())
  projectId    String
  status       DeploymentStatus @default(PENDING)
  provider     String           @default("coolify")
  deployUrl    String?
  commitSha    String?
  commitMsg    String?
  coolifyDeployId String?
  logs         String?          @db.Text
  startedAt    DateTime         @default(now())
  finishedAt   DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("deployments")
}

enum DeploymentStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  path      String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@map("project_files")
}

model AiTask {
  id        String       @id @default(cuid())
  projectId String
  prompt    String       @db.Text
  status    AiTaskStatus @default(PENDING)
  steps     Json         @default("[]")
  error     String?      @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("ai_tasks")
}

enum AiTaskStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum ProjectStatus {
  IDLE
  BUILDING
  RUNNING
  ERROR
  DEPLOYED
}

model Conversation {
  id        String    @id @default(cuid())
  projectId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("conversations")
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model AiModelConfig {
  id        String   @id @default(cuid())
  modelId   String   @unique
  label     String
  provider  String
  enabled   Boolean  @default(false)
  isFast    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_model_configs")
}

model CreditWallet {
  id                  String    @id @default(cuid())
  userId              String    @unique
  balance             Int       @default(0)
  lifetimeCredits     Int       @default(0)
  usedCredits         Int       @default(0)
  dailyCredits        Int       @default(5)
  dailyCreditsDate    DateTime  @default(now())
  monthlyCreditsUsed  Int       @default(0)
  updatedAt           DateTime  @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@map("credit_wallets")
}

model CreditTransaction {
  id           String          @id @default(cuid())
  walletId     String
  type         TransactionType
  amount       Int
  balanceAfter Int
  description  String?
  reference    String?
  createdAt    DateTime        @default(now())

  wallet CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("credit_transactions")
}

enum TransactionType {
  CREDIT
  DEBIT
}

model SubscriptionPlan {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?
  priceMonthly   Int      // in centavos (PHP)
  credits        Int
  maxProjects    Int      @default(5)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  planId               String
  status               SubscriptionStatus @default(ACTIVE)
  provider             PaymentProvider
  providerSubscriptionId String?          @unique
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  EXPIRED
}

model Payment {
  id             String          @id @default(cuid())
  userId         String
  subscriptionId String?
  provider       PaymentProvider
  providerPaymentId String?      @unique
  amount         Int             // in centavos
  currency       String          @default("PHP")
  status         PaymentStatus   @default(PENDING)
  description    String?
  checkoutUrl    String?
  metadata       Json            @default("{}")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("payments")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  EXPIRED
}

enum PaymentProvider {
  XENDIT
  HITPAY
}

model PaymentWebhook {
  id        String          @id @default(cuid())
  provider  PaymentProvider
  eventType String
  payload   Json
  processed Boolean         @default(false)
  error     String?
  createdAt DateTime        @default(now())

  @@map("payment_webhooks")
}

model TeamMember {
  id        String     @id @default(cuid())
  projectId String
  userId    String
  role      TeamRole   @default(VIEWER)
  createdAt DateTime   @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("team_members")
}

enum TeamRole {
  OWNER
  EDITOR
  VIEWER
}

model ProjectTemplate {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  category    String
  prompt      String   @db.Text
  icon        String   @default("layout")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("project_templates")
}
